{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**"
    ],
    "public": ".",
    "site": "mangawa",
    "rewrites": [
      {
        "source": "/",
        "destination": "/boxing/boxing.html"
      }
    ]
  }
}